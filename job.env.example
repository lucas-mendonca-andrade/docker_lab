# Copie este arquivo pra job.env e guarde na RAIZ do projeto que voce quer executar
# (ex. ~/meu_projeto/job.env) — nunca dentro do docker_lab/. Edite os valores abaixo.
#
# Instalacao COMPARTILHADA (varios alunos, cada um com seu proprio projeto): o
# docker_lab fica instalado uma unica vez num local do sistema (ex. /opt/amlb_ainet_lab)
# — voce roda apontando pro seu job.env, com o caminho completo do run.sh, ex.:
#   /opt/amlb_ainet_lab/docker_lab/run.sh ~/meu_projeto/job.env
# Nao precisa copiar o docker_lab pra dentro do seu proprio projeto.

# Caminho ABSOLUTO da raiz do SEU projeto (onde SCRIPT/PYTHON_BIN abaixo vao ser
# resolvidos, e o que sera montado dentro do container). NORMALMENTE VOCE NAO PRECISA
# PREENCHER ISSO — o padrao e auto-detectar a pasta onde este proprio job.env esta (por
# isso a convencao de sempre guardar o job.env na raiz do projeto). So preencha se, por
# algum motivo, seu job.env nao estiver na raiz do projeto de verdade.
#REPO_ROOT=/caminho/absoluto/do/seu/projeto

# Script a rodar, caminho relativo a REPO_ROOT.
SCRIPT=run_all_frameworks_1.py

# Python usado pra rodar o SCRIPT, dentro do container — caminho relativo a REPO_ROOT,
# igual o SCRIPT acima (ex. venv/bin/python, se seu projeto tiver um venv proprio ja
# instalado). Ou "python3" se for depender so do requirements.txt deste diretorio
# (roda no Python 3.12 da imagem).
PYTHON_BIN=venv/bin/python

# QUANTIDADE de cores que este job pode usar (nao IDs especificos) — o wrapper escolhe
# quais cores livres da maquina usar. Isso vale mesmo se o script fizer 'taskset -c X,Y'
# fixo internamente (varios run_all_frameworks_*.py fazem): o container neutraliza esse
# taskset interno (ver fake-bin/taskset) e usa so os cores que o wrapper reservou de
# verdade. Ponha aqui quantos cores o SEU script pede (2, no caso do
# run_all_frameworks_1.py).
CORES=2

# Memoria maxima (GB) que o container pode usar. O container e morto (OOM) se passar disso.
MEMORY_GB=16

# "none" pra nao usar GPU, ou o indice da GPU (0, 1, ...) que este job vai usar. Varios
# jobs podem dividir a mesma GPU: cada um reserva uma parte da VRAM (abaixo), e a soma
# de todos nunca passa de 80% da VRAM. O processamento da GPU e dividido entre os jobs
# automaticamente (com 2 jobs na mesma GPU, cada um fica mais lento).
GPU=none

# VRAM maxima (GB) que o job pode usar na GPU — obrigatorio com GPU definida. Alocar alem
# disso da "CUDA out of memory". O driver ainda usa ~0,3GB fixo por processo (contexto
# CUDA) alem desse valor — normal, o teto de 80% ja deixa folga pra isso. Pra descobrir quanto seu script usa: rode uma vez e
# veja o pico (PyTorch: torch.cuda.max_memory_allocated(); ou nvidia-smi durante a execucao).
GPU_MEMORY_GB=4

# Identificador deste job (usado pro nome do container e pra rastrear a reserva de
# recurso). Deixe o '{USERNAME}' EXATAMENTE como esta — o run.sh troca isso pelo seu
# usuario real do sistema automaticamente (voce nao precisa saber/digitar o proprio
# usuario). Depois do '_' ponha o que quiser, algo que ninguem mais vai usar.
JOB_NAME={USERNAME}_run_all_frameworks_1
